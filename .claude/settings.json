{
  "permissions": {
    "allow": [
      "Bash(cct-gate*)",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebSearch",
      "mcp__github-tools__*",
      "mcp__MCP_DOCKER__*",
      "mcp__dotnet-tools__*",
      "mcp__rust-tools__*",
      "mcp__ollama-tools__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_playwright_playwright__*",
      "mcp__windows-mcp__*",
      "mcp__sqlite__*",
      "mcp__searxng__*",
      "mcp__open-brain__*",
      "mcp__godot-tools__*",
      "mcp__plugin_context-mode_context-mode__*",
      "mcp__template-sync-tools__*",
      "mcp__git-tools__*"
    ],
    "deny": [
      "mcp__git-tools__git_push",
      "mcp__git-tools__git_commit",
      "mcp__git-tools__git_revert",
      "mcp__git-tools__git_rebase",
      "mcp__git-tools__git_reset"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "cct@dagonet": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=$(cat | grep -o '\"session_id\" *: *\"[^\"]*\"' | head -1 | sed 's/.*\"\\([^\"]*\\)\"$/\\1/'); case $s in ''|*[!A-Za-z0-9-]*) s= ;; esac; d=\"${TMPDIR:-/tmp}/cct-$(id -u)\"; o=; case $(uname -s) in MINGW*|MSYS*|CYGWIN*) o=1 ;; *) [ -O \"$d\" ] && o=1 ;; esac; [ -n \"$s\" ] && [ -n \"$o\" ] && [ -f \"$d/$s\" ] && exit 0; echo 'BLOCKED: the cct plugin is not active in this session. Install it with /plugin marketplace add dagonet/claude-code-toolkit and /plugin install cct@dagonet, then restart the session.' >&2; exit 2"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
