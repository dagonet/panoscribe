# panoscribe Configuration
# Copy to .env and adjust as needed

# ASR (Speech Recognition)
PANO_WHISPER_MODEL=large-v3-turbo
PANO_WHISPER_DEVICE=cuda          # cuda, cpu, auto
PANO_WHISPER_COMPUTE_TYPE=float16  # float16, int8_float16, int8
# PANO_WHISPER_LANGUAGE=            # leave empty for auto-detect
PANO_WHISPER_BATCH_SIZE=16

# OCR (On-Screen Text)
PANO_OCR_ENGINE=paddleocr
PANO_OCR_LANGUAGES=["en","de"]
# RapidOCR LangRec value (e.g., "en", "ch", "japan", "korean") — not ISO 639. See https://github.com/RapidAI/RapidOCR/blob/v3.8.1/python/rapidocr/utils/typings.py for the full enum.
PANO_OCR_LANGUAGE=en
PANO_OCR_DEVICE=cuda
PANO_OCR_CONFIDENCE_THRESHOLD=0.6
PANO_OCR_FRAME_INTERVAL=0.5
PANO_OCR_USE_SCENE_DETECTION=true

# Platform
PANO_PLATFORM_AUTO_DETECT=true
# PANO_PLATFORM_OVERRIDE=           # force: tiktok, youtube, instagram
PANO_UI_FILTER_ENABLED=true

# Merge / Deduplication
PANO_DEDUP_SIMILARITY_THRESHOLD=0.85
PANO_DEDUP_STRATEGY=prefer_asr     # prefer_asr, prefer_ocr, keep_both

# LLM Cleanup (optional, requires ollama)
PANO_LLM_CLEANUP_ENABLED=false
PANO_LLM_MODEL=llama3
PANO_LLM_BASE_URL=http://localhost:11434

# Output
PANO_OUTPUT_FORMAT=json             # json, txt, srt, vtt, md
PANO_INCLUDE_METADATA=true
PANO_INCLUDE_CONFIDENCE_SCORES=false

# General
PANO_TEMP_DIR=/tmp/panoscribe
PANO_KEEP_TEMP_FILES=false
PANO_LOG_LEVEL=INFO
